<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Light. The WebView reports prefers-color-scheme from the app theme, so night mode uses a dark parent (values-night). -->
    <style name="Theme.Shufang" parent="android:Theme.DeviceDefault.Light.NoActionBar">
        <item name="android:windowBackground">@color/paper</item>
        <item name="android:statusBarColor">@color/paper</item>
        <item name="android:colorBackground">@color/paper</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
</resources>
